# =================================================================
# GAMELIFT ANALOGUE CONSOL - CONFIGURATION LOCALE VERROUILLEE
# =================================================================

# Port d'ecoute HTTP et WebSocket du Hub Local
PORT=3000

# Mode d'operation : 'EMULATOR' (Anywhere Hors-ligne) ou 'LIVE_AWS' (Reel AWS SDK)
GAMELIFT_MODE=EMULATOR

# Region AWS ciblee et endpoint officiel GameLift
AWS_REGION=us-east-2
GAMELIFT_ENDPOINT=https://gamelift.us-east-2.amazonaws.com/

# Identifiants AWS IAM (Requis uniquement en mode LIVE_AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Flotte et Emplacement GameLift Anywhere
GAMELIFT_FLEET_ID=fleet-intel-anywhere-001
GAMELIFT_LOCATION=custom-intel-dev
COMPUTE_NAME=IntelDevPC
COMPUTE_IP=127.0.0.1
COMPUTE_PORT=7777

# Cle secrete maitresse de l'Enclave Locale Verrouillee
VAULT_MASTER_SECRET=vault_master_seed_salib_consol_2026_secure_key

# Chemin d'archivage du Ledger d'audit (versement des dialogues)
LEDGER_PATH=./ledger/dialogue_ledger.jsonl
